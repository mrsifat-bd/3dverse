# Copy to ".env.local" and fill in from Supabase Dashboard -> Project Settings -> API.
# Use ONLY the public "anon" key. Never the service_role/secret key.
# If left blank, the site runs in demo mode with built-in sample products.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL (used for absolute product links in WhatsApp messages, sitemap, OG tags).
# Locally you can leave this as-is; in production set it to your Vercel domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
