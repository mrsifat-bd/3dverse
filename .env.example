# Copy to ".env.local" and fill in from Supabase Dashboard -> Project Settings -> API.
# Use ONLY the public "anon" key. Never the service_role/secret key.
# If left blank, the site runs in demo mode with built-in sample products.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL — used ONLY for OG/meta tags, sitemap, robots, and WhatsApp links.
# Local dev: http://localhost:3000  |  Production (Vercel): https://3dversebd.com
NEXT_PUBLIC_SITE_URL=https://3dversebd.com

# ---------------------------------------------------------------------------
# Steadfast Courier (server-side ONLY — never prefix these with NEXT_PUBLIC).
# Get the keys from the Steadfast merchant portal. Add them in Vercel ->
# Project -> Settings -> Environment Variables (Production). Leave blank to
# keep the courier feature dormant (orders still work; parcel creation is off).
# ---------------------------------------------------------------------------
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
# Optional overrides (defaults are fine for most cases):
# STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
# Public customer tracking link base (safe to expose):
# NEXT_PUBLIC_STEADFAST_TRACKING_URL_BASE=https://steadfast.com.bd/t

# ---------------------------------------------------------------------------
# Admin allowlist (server-side). Comma-separated emails that get admin access.
# Keep in sync with the public.admin_emails table in Supabase. Defaults to the
# owner account if unset.
# ---------------------------------------------------------------------------
ADMIN_EMAILS=3dverse.bd@gmail.com
